# Public variables (end up in the bundle): never secrets or tokens. Read only in src/shared/config/env.ts.
VITE_API_BASE_URL=/api
VITE_DEFAULT_LOCALE=it
# true = Mock Service Worker answers /api in `npm run dev` (no backend needed)
VITE_API_MOCKS=false
# Mock user when VITE_API_MOCKS=true: manager | viewer
VITE_MOCK_USER=manager

# Dev only (vite.config.ts, not exposed to the bundle): BFF reached by the /api proxy
API_PROXY_TARGET=http://localhost:8080
