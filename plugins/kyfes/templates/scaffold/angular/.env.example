# Variabili PUBBLICHE (finiscono nel bundle): mai segreti, token o chiavi private.
# Angular CLI non legge file .env: questi valori si impostano in angular.json →
# projects.scaffold-angular.architect.build.(options|configurations.*).define
# come letterali JS (es. "NG_APP_API_BASE_URL": "'/api'"). Sono validati con Zod in
# src/app/shared/config/env.ts, unico punto che li legge.
NG_APP_API_BASE_URL=/api
NG_APP_DEFAULT_LOCALE=it
# true solo in sviluppo (configurazione "mocks", npm run dev:mocks): avvia MSW nel browser.
NG_APP_API_MOCKS=false
