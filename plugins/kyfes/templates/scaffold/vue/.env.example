# Public variables (VITE_ prefix = shipped in the bundle: never put secrets here)
VITE_API_BASE_URL=/api
VITE_DEFAULT_LOCALE=it
# true = intercept /api with MSW in `npm run dev` (dev only)
VITE_API_MOCKS=true

# Dev server only (no VITE_ prefix): where the /api proxy forwards requests
API_ORIGIN=http://localhost:8080
