{
  "name": "kyfes-scaffold-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@casl/ability": "^7.0.2",
    "@casl/vue": "^3.0.1",
    "@tanstack/vue-query": "^5.104.4",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "pinia": "^4.1.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "sideEffects": [
    "**/*.css",
    "src/app/main.ts",
    "src/shared/charts/echarts.ts"
  ]
