# Public variables (inlined in the client bundle): never put secrets here.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_DEFAULT_LOCALE=it
# true = MSW intercepts /api in the browser (development only)
NEXT_PUBLIC_API_MOCKS=false

# Server-only: origin of the backend/BFF that /api/* is rewritten to.
API_ORIGIN=https://api.example.com
